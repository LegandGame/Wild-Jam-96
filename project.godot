; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Static Knights"
config/version="0.1"
run/main_scene="res://ui/opening/opening.tscn"
config/features=PackedStringArray("4.7")
config/icon="uid://dpbnxn6gvroe6"

[autoload]

GUIDE="*uid://p2jwrgjcbexr"
PhantomCameraManager="*uid://duq6jhf6unyis"
ScreenSpaceEdges="*uid://bsluhmkfltf41"
AudioManager="*uid://dhkba5213rmw4"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Maaack-s Minimal Game Template"

[editor_plugins]

enabled=PackedStringArray("res://addons/maaacks_credits_scene/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "red",
"res://common/": "yellow",
"res://entities/": "blue",
"res://scenes/": "purple",
"res://ui/": "orange"
}

[gui]

theme/custom="res://ui/resources/themes/lab.tres"
common/drop_mouse_on_gui_input_disabled=true

